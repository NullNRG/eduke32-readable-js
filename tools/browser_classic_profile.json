{
  "format": "sourcefactory-browser-profile/1",
  "name": "browser-classic-single-player",
  "status": "provisional-until-make-inventory-and-gameplay-verified",
  "source_commands": "factory-output/compile_commands.json",
  "derived_commands": "factory-output/browser-classic/compile_commands.json",
  "build_root": "factory-output/source-first/browser-classic",
  "boot_module_root": "factory-output/source-first/browser-classic/browser-modules",
  "migration_input": "factory-output/source-first/oct20-engine-preinit-browser",
  "migration_policy": "reuse only after source, configuration, target ABI, compiler and runtime fingerprints are verified",
  "remove_defines": [
    "USE_OPENGL",
    "POLYMER",
    "STARTUP_WINDOW",
    "USE_MIMALLOC",
    "HAVE_VORBIS",
    "HAVE_FLAC",
    "HAVE_XMP",
    "USE_LIBVPX",
    "HAVE_GTK2"
  ],
  "add_defines": [
    "NOASM",
    "NETCODE_DISABLE"
  ],
  "retained_media": [
    "VOC",
    "MID",
    "ART",
    "MAP",
    "CON",
    "ANM"
  ],
  "inventory_policy": "Original Make selects the classic SUBPLATFORM=BROWSER profile. Byte-attested adaptations exclude ALSA and native small-pool/TLS allocation optimizations. Browser allocation wrappers call the original GenericAllocator bodies; original SDL/OPL/mixer and game behavior remain selected. Excluded pool units are not recovered definitions. Captured-command derivation is diagnostic only.",
  "allocator_backend": "original-sm-GenericAllocator",
  "execution_policy": {
    "format": "readable-engine-native-services/1",
    "engine_language": "readable-javascript",
    "native_service_backend": "sdl2-wasm32",
    "native_allowed_roles": [
      "sdl2",
      "platform",
      "timing",
      "audio-backend"
    ],
    "native_allowed_project_sources": [
      "runtime/native_services/sdl_services.c"
    ],
    "original_game_or_build_engine_in_wasm": false,
    "engine_abi": "source-lp64-addresses/2",
    "service_pointer_bits": 32,
    "shared_engine_memory": false,
    "service_manifest": "factory-output/browser-services/build-manifest.json"
  },
  "excluded_allocator_units": [
    "source/build/src/smmalloc.cpp",
    "source/build/src/smmalloc_tls.cpp"
  ],
  "gameplay_verified": false,
  "preparation_tool": "tools/prepare_browser_classic.py",
  "prepared_source_root": "factory-output/browser-classic/source-tree/eduke32-master",
  "browser_define": "EDUKE32_BROWSER",
  "engine_execution_report": "reports/browser-classic-original-engine-video.json",
  "source_defines": {
    "source/build/src/lz4.c": [
      "LZ4_FAST_DEC_LOOP=0"
    ]
  },
  "source_define_policy": "Use the original portable LZ4 decoder in readable JavaScript. CPU fast-loop helpers are excluded by its original build option; original source and public codec APIs are preserved."
}
