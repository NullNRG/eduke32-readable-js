# Default deny: only the canonical source inputs and continuation essentials.
*
!*/
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/dev-requirements.txt
!/index.html
!/launch-project.cmd
!/launch-project.ps1
!/README.md
!/README_SOURCE_FACTORY.md
!/BUILD_PORTABILITY.md
!/CONTINUE_HERE.md
!/CURRENT_PORT_STATUS.md
!/HANDOFF_SNAPSHOT.json
!/LLM_CONTINUATION_PROMPT.md
!tools/**
!runtime/**
!tests/**
!licenses/**
!input-source/*.zip
!factory-output/compile_commands.json
!factory-output/source-first/oct20-engine-preinit-browser/**
!work/*.py
!work/*.ps1
!work/*.json
!work/*.mjs
!work/*.md
!reports/project-current-status.json
!reports/port-acceptance.json
!reports/oct27-final-recovery-regression.json
!reports/oct25-original-libdivide-parity.json
!reports/oct27-original-xxhash-parity.json
!reports/oct27-rotation-barriers-parity.json
!reports/oct27-aligned-hints-parity.json
!.github/workflows/**
# Never publish game data, generated pages containing embedded data, installed
# dependencies, executables, caches, or continuation ZIPs.
**/*.[gG][rR][pP]
dist/**
input-data/**
node_modules/**
handoffs/**
**/__pycache__/**
*.pyc
*.exe
*.dll
*.o
*.obj
*.sqlite
*.partial
*.tmp
work/dependencies/**
work/toolchains/**
work/native-oracle/**
